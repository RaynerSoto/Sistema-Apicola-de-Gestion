<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>cu.edu.cujae</groupId>
	<artifactId>APIApicola</artifactId>
	<version>1.0-SNAPSHOT</version>
	<name>API Apicola</name>
	<description>API Apicola</description>
	<packaging>pom</packaging>
	<developers>
		<developer>
			<name>Rayner Alejandro Soto Martínez</name>
			<email>raynersoto01@gmail.com</email>
			<url>https://www.linkedin.com/in/rayner-alejandro/</url>
			<roles>
				<role>Desarrollador de software</role>
			</roles>
		</developer>
	</developers>
	<modules>
		<module>API Gateway</module>
		<module>Eureka Server</module>
		<module>Config Server</module>
		<module>Gestion</module>
	</modules>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.34</version>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-parent</artifactId>
					<version>3.3.5</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
